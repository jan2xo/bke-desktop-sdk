<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>BKE.Updater</RootNamespace>
    <AssemblyName>BKE.Updater</AssemblyName>
    <PackageId>BKE.Updater</PackageId>
    <Version>0.4.0</Version>
    <PackageVersion>0.4.0</PackageVersion>
    <Authors>BKE Digital Solutions</Authors>
    <Description>Product-neutral secured update capability with a default BKE Licensing Agent client.</Description>
    <PackageReleaseNotes>Adds the default fixed-loopback Licensing Agent client implementation behind the hardened bke.updates.check contract without exposing provider authority or transport details to products.</PackageReleaseNotes>
    <RepositoryUrl>https://github.com/jan2xo/bke-sdk</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageLicenseFile>LICENSE-BKE-PROPRIETARY.txt</PackageLicenseFile>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);1591</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="BKE.Updater.Tests" />
    <None Include="../../LICENSE-BKE-PROPRIETARY.txt" Pack="true" PackagePath="LICENSE-BKE-PROPRIETARY.txt" />
    <None Include="../../README.md" Pack="true" PackagePath="README.md" />
  </ItemGroup>
</Project>