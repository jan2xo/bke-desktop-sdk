<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>BKE.Updater</RootNamespace>
    <AssemblyName>BKE.Updater</AssemblyName>
    <PackageId>BKE.Updater</PackageId>
    <Version>0.2.0</Version>
    <PackageVersion>0.2.0</PackageVersion>
    <Authors>BKE Digital Solutions</Authors>
    <Description>Product-neutral secured update capability contracts.</Description>
    <PackageLicenseFile>LICENSE-BKE-PROPRIETARY.txt</PackageLicenseFile>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);1591</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <None Include="../../LICENSE-BKE-PROPRIETARY.txt" Pack="true" PackagePath="LICENSE-BKE-PROPRIETARY.txt" />
    <None Include="../../README.md" Pack="true" PackagePath="README.md" />
  </ItemGroup>
</Project>