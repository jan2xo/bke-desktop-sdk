<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>BKE.Desktop.Client</AssemblyName>
    <RootNamespace>BKE.Desktop.Client</RootNamespace>

    <Version>2.0.0</Version>
    <PackageId>BKE.Desktop.Client</PackageId>
    <PackageTitle>BKE Desktop Client SDK</PackageTitle>
    <Authors>BKE Digital Solutions</Authors>
    <Description>Typed .NET 10 client for the BKE Licensing Agent desktop integration contract.</Description>
    <PackageTags>bke;desktop;sdk;licensing-agent;dotnet</PackageTags>
    <PackageReleaseNotes>Initial .NET 10 integration client release. Consumer migration and production publication are separate phases.</PackageReleaseNotes>
    <RepositoryUrl>https://github.com/jan2xo/bke-sdk</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageLicenseFile>LICENSE.txt</PackageLicenseFile>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageOutputPath>$(MSBuildThisFileDirectory)..\..\artifacts</PackageOutputPath>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="BKE.Desktop.Client.Tests" />
    <None Include="$(MSBuildThisFileDirectory)..\..\README.md" Pack="true" PackagePath="README.md" />
    <None Include="$(MSBuildThisFileDirectory)..\..\LICENSE.txt" Pack="true" PackagePath="LICENSE.txt" />
  </ItemGroup>
</Project>